# Copy to .env.local and configure your own services. Never commit real credentials.
# Firebase browser configuration (public values)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Firebase Admin credentials (server-only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# AI question generation and feedback (server-only)
GOOGLE_GENERATIVE_AI_API_KEY=
# Retell voice API and configured agent IDs
RETELL_API_KEY=
NEXT_PUBLIC_RETELL_AGENT_ID=
NEXT_PUBLIC_RETELL_INTERVIEW_AGENT_ID=
